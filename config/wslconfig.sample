# Sample .wslconfig for Hardware Offloading & Enclave Isolation
# Placed at: %USERPROFILE%\.wslconfig
[wsl2]
# System Allocation: 16GB RAM for heavy vector embeddings and local LLM weights
memory=16GB

# Logical Processors: 12 threads allocated (reserving 4 threads for host Windows stability)
processors=12

# Swap space allocated for virtual memory headroom
swap=4GB

[experimental]
# Gradual auto-memory reclamation: releases memory spikes after batch embedding pipelines
autoMemoryReclaim=gradual

# Automatically shrink virtual disks to avoid disk bloat
sparseVhd=true
