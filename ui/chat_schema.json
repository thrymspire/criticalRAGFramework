{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critical RAG Multi-Turn Dialogue Schema",
  "description": "Schema for conversational multi-turn directives, SSE streaming events, and CanaryAnchor provenance verification.",
  "chat_request": {
    "type": "object",
    "required": ["messages"],
    "properties": {
      "messages": {
        "type": "array",
        "description": "Ordered multi-turn conversation history.",
        "items": {
          "type": "object",
          "required": ["role", "content"],
          "properties": {
            "role": {
              "type": "string",
              "enum": ["system", "user", "assistant"]
            },
            "content": {
              "type": "string",
              "description": "Text payload of the conversational turn."
            }
          }
        }
      },
      "agent": {
        "type": "string",
        "description": "Active agent persona key (framework, engineer, mechanic, analyst, debug)",
        "default": "framework"
      },
      "max_tokens": {
        "type": "integer",
        "default": 256,
        "maximum": 2048
      },
      "rag_enabled": {
        "type": "boolean",
        "default": true,
        "description": "Whether to ground the turn using 3-tier hierarchical RAG."
      }
    }
  },
  "stream_events": {
    "retrieval_event": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "retrieval" },
        "retrieved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "score": { "type": "number" },
              "type": { "type": "string" }
            }
          }
        }
      }
    },
    "token_event": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "token" },
        "step": { "type": "integer" },
        "chosen_token": { "type": "string" },
        "prob": { "type": "number" },
        "entropy": { "type": "number" },
        "running_text": { "type": "string" },
        "top": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "token": { "type": "string" },
              "prob": { "type": "number" }
            }
          }
        },
        "watermark_retention": { "type": "number" },
        "context_fidelity_pct": { "type": "number" }
      }
    },
    "verification_event": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "const": "verification" },
        "verification": {
          "type": "object",
          "properties": {
            "mean_entropy_bits": { "type": "number" },
            "chunks_cited": { "type": "array", "items": { "type": "string" } },
            "epistemological_gap_declared": { "type": "boolean" },
            "retrieval_confidence": { "type": "string" },
            "verification_status": { "type": "string" },
            "context_fidelity_pct": { "type": "number" },
            "fidelity_status": { "type": "string" }
          }
        }
      }
    }
  }
}
